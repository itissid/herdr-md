#!/usr/bin/env python3
"""Open local Markdown in Herdr's shared layout via the existing LOCAL core.

No SSH, shell execution, daemon, network listener or new remote transport.
The layout format is source-derived, NOT a stable core pane-create API.
"""
import argparse
import codecs
import copy
import json
import math
import os
from pathlib import Path
import re
import socket
import sys
import time
import uuid

DOC_NAME = "herdr-app"
MAX_DOCUMENT = 1024 * 1024
MAX_MARKDOWN = 16 * 1024 * 1024
MAX_RESPONSE = 2 * 1024 * 1024
KINDS = {"row", "column", "stack", "block"}


class OpenError(Exception):
    pass


class TransportError(OpenError):
    pass


class RpcError(OpenError):
    def __init__(self, error):
        self.code = error.get("code")
        self.message = str(error.get("message", "Core rejected request"))
        data = error.get("data")
        self.kind = data.get("kind") if isinstance(data, dict) else None
        super().__init__(self.message)

    def conflict(self):
        text = self.message.lower()
        if self.kind is not None:
            return self.kind == "conflict"
        return "version" in text and any(word in text for word in ("conflict", "mismatch", "stale"))


def encoded(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"), allow_nan=False).encode("utf-8")


class Core:
    """Bounded newline JSON-RPC over one local UNIX socket, protocol generation 1."""
    def __init__(self, path, timeout=3):
        self.path, self.timeout = path, timeout
        self.sock, self.buffer, self.sequence = None, b"", 0

    def __enter__(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        try:
            self.sock.connect(self.path)
        except OSError as error:
            self.sock.close()
            raise TransportError("Cannot connect to local core socket: %s" % error)
        return self

    def __exit__(self, *_):
        self.sock.close()

    def rpc(self, method, params):
        self.sequence += 1
        request_id = self.sequence
        request = {"jsonrpc": "2.0", "id": request_id, "method": method, "params": params}
        deadline = time.monotonic() + self.timeout
        try:
            self.sock.settimeout(self.timeout)
            self.sock.sendall(encoded(request) + b"\n")
            while True:
                while b"\n" not in self.buffer:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TransportError("Local core response timed out")
                    self.sock.settimeout(remaining)
                    chunk = self.sock.recv(65536)
                    if not chunk:
                        raise TransportError("Local core disconnected (write outcome may be unknown)")
                    self.buffer += chunk
                    if len(self.buffer) > MAX_RESPONSE:
                        raise OpenError("Local core response exceeds size limit")
                line, self.buffer = self.buffer.split(b"\n", 1)
                if time.monotonic() > deadline:
                    raise TransportError("Local core response timed out")
                try:
                    response = json.loads(line.decode("utf-8"))
                except (ValueError, UnicodeError):
                    raise OpenError("Malformed local core JSON response")
                if not isinstance(response, dict) or response.get("jsonrpc") != "2.0":
                    raise OpenError("Invalid local core RPC envelope")
                if "id" not in response:  # Native event notification; not our response.
                    continue
                if response["id"] != request_id:
                    raise OpenError("Unexpected local core response ID")
                if "error" in response:
                    if not isinstance(response["error"], dict):
                        raise OpenError("Malformed local core error")
                    raise RpcError(response["error"])
                if "result" not in response:
                    raise OpenError("Local core response has no result")
                return response["result"]
        except (OSError, socket.timeout) as error:
            raise TransportError("Local core transport failed: %s" % error)


def markdown_path(value):
    try:
        path = Path(value).expanduser().resolve(strict=True)
        if not path.is_file():
            raise OpenError("Markdown path is not a regular file")
        if path.suffix.lower() not in (".md", ".markdown", ".mdx"):
            raise OpenError("Markdown only: PDF and other file types are unsupported")
        if any(c in str(path) for c in "\0\r\n"):
            raise OpenError("Markdown path contains unsupported control characters")
        if path.stat().st_size > MAX_MARKDOWN:
            raise OpenError("Markdown exceeds 16MiB validation limit")
        decoder = codecs.getincrementaldecoder("utf-8")()
        total = 0
        with path.open("rb") as stream:
            while True:
                chunk = stream.read(65536)
                if not chunk:
                    decoder.decode(b"", final=True)  # Reject incomplete UTF-8 at EOF.
                    break
                total += len(chunk)
                if total > MAX_MARKDOWN:
                    raise OpenError("Markdown exceeds 16MiB validation limit")
                if b"\0" in chunk:
                    raise OpenError("Markdown contains binary data")
                decoder.decode(chunk, final=False)
        return str(path)
    except (OSError, UnicodeError, RuntimeError) as error:
        raise OpenError("Cannot read local Markdown: %s" % error)


def ident(value):
    return isinstance(value, str) and bool(value) and not any(ord(c) < 32 for c in value)


def inspect_document(value):
    """Validate known native node model and index nodes without changing input."""
    if not isinstance(value, dict) or not isinstance(value.get("spaces"), list):
        raise OpenError("Unknown herdr-app document: expected spaces list; refusing to initialize/reset")
    nodes, tabs, spaces = {}, set(), set()

    def content_ok(content):
        keys = [key for key in ("terminal", "mod", "context", "agent") if isinstance(content, dict) and key in content]
        if len(keys) != 1 or not ident(content[keys[0]]):
            raise OpenError("Unknown/malformed native block content")

    def walk(node, space, tab, parent, stack, hidden=False):
        if not isinstance(node, dict) or node.get("type") not in KINDS or not ident(node.get("id")):
            raise OpenError("Unknown native layout node; refusing structural edit")
        if node["id"] in nodes:
            raise OpenError("Duplicate native pane/node ID")
        if "size" in node:
            size = node["size"]
            if not isinstance(size, dict) or len(size) != 1 or next(iter(size)) not in ("weight", "px"):
                raise OpenError("Unknown native pane size")
            n = next(iter(size.values()))
            if isinstance(n, bool) or not isinstance(n, (int, float)) or not math.isfinite(n) or n <= 0:
                raise OpenError("Invalid native pane size")
        if "hidden" in node and type(node["hidden"]) is not bool:
            raise OpenError("Invalid native hidden flag")
        hidden = hidden or node.get("hidden", False)
        nodes[node["id"]] = (node, space, tab, parent, stack, False, hidden)
        # Native floats are flat {id,content,...} entries on EACH node, not
        # tab.floating[].node. Include them in collision/source validation.
        floats = node.get("floating", [])
        if not isinstance(floats, list):
            raise OpenError("Unknown native floating layout")
        for item in floats:
            if not isinstance(item, dict) or not ident(item.get("id")):
                raise OpenError("Unknown native floating pane")
            if item["id"] in nodes:
                raise OpenError("Duplicate native pane/node ID")
            content_ok(item.get("content"))
            nodes[item["id"]] = (item, space, tab, None, stack, True, hidden)
        if node["type"] == "block":
            content_ok(node.get("content"))
        else:
            children = node.get("children")
            if not isinstance(children, list) or not children:
                raise OpenError("Unknown/empty native container")
            for child in children:
                walk(child, space, tab, node, stack or node["type"] == "stack", hidden)

    for space in value["spaces"]:
        if not isinstance(space, dict) or not ident(space.get("id")) or space["id"] in spaces or not isinstance(space.get("tabs"), list):
            raise OpenError("Unknown/duplicate native workspace")
        spaces.add(space["id"])
        for tab in space["tabs"]:
            if not isinstance(tab, dict) or not ident(tab.get("id")) or tab["id"] in tabs or "root" not in tab:
                raise OpenError("Unknown/duplicate native tab")
            tabs.add(tab["id"])
            walk(tab["root"], space, tab, None, False)
            if "floating" in tab:
                raise OpenError("Unsupported tab-level floating representation")
    return nodes


def plan_open(value, path, on, terminal, operation_id, new_tab=False):
    """Pure reapplication against the latest document. Returns (value, result)."""
    document = copy.deepcopy(value)
    nodes = inspect_document(document)
    pane_id, row_id, tab_id = "p" + operation_id, "r" + operation_id, "tb" + operation_id
    content = {"mod": "herdr-md", "props": {"file": path, "on": on,
               "herdr_open": {"operation_id": operation_id, "terminal": terminal, "new_tab": new_tab}}}
    if pane_id in nodes:
        node, space, tab, _, _, _, _ = nodes[pane_id]
        if node.get("content") != content:
            raise OpenError("Operation ID already exists with different arguments/content")
        return document, {"operation_id": operation_id, "pane_id": pane_id, "tab_id": tab["id"], "space_id": space["id"], "reused": True}
    if row_id in nodes or any(tab["id"] == tab_id for space in document["spaces"] for tab in space["tabs"]):
        raise OpenError("Operation ID collides with existing layout")
    sources = [entry for entry in nodes.values() if entry[0].get("content", {}).get("terminal") == terminal]
    if len(sources) != 1:
        raise OpenError("Expected exactly one source terminal pane; found %d" % len(sources))
    source, space, tab, parent, in_stack, floating, hidden = sources[0]
    if floating or (in_stack and not new_tab) or hidden:
        raise OpenError("Source is floating, stacked or hidden; use a normal pane (--new-tab supports stacks)")
    pane = {"type": "block", "id": pane_id, "content": content}
    if new_tab:
        tab = {"id": tab_id, "name": "Markdown: " + Path(path).name,
               "root": {"type": "row", "id": row_id, "children": [pane]}}
        space["tabs"].append(tab)
    elif parent is not None and parent["type"] == "row":
        # Match native Node::split: existing row splits source weight in half;
        # an explicitly pixel-sized source retains its size, new leaf gets .5.
        size = source.get("size", {"weight": 1.0})
        if "weight" in size:
            half = size["weight"] / 2
            source["size"] = {"weight": half}
        else:
            half = 0.5
        pane["size"] = {"weight": half}
        index = next(i for i, child in enumerate(parent["children"]) if child is source)
        parent["children"].insert(index + 1, pane)
    else:
        # Native orthogonal split: keep exterior size, reset children to weight1.
        row = {"type": "row", "id": row_id, "children": [source, pane]}
        if "size" in source:
            row["size"] = source.pop("size")
        if parent is None:
            tab["root"] = row
        else:
            index = next(i for i, child in enumerate(parent["children"]) if child is source)
            parent["children"][index] = row
    if len(encoded(document)) > MAX_DOCUMENT:
        raise OpenError("Updated layout exceeds core document byte limit")
    return document, {"operation_id": operation_id, "pane_id": pane_id, "tab_id": tab["id"], "space_id": space["id"], "reused": False}


def open_document(socket_path, terminal, path, on, operation_id, new_tab=False, retries=3, timeout=3, client_factory=Core):
    last_error = None
    acknowledged = False
    uncertain_write = False
    for _ in range(retries + 1):
        try:
            with client_factory(socket_path, timeout) as core:
                hello = core.rpc("hello", {})
                if not isinstance(hello, dict) or type(hello.get("generation")) is not int or hello["generation"] != 1:
                    raise OpenError("Unsupported core protocol generation")
                snapshot = core.rpc("doc.get", {"name": DOC_NAME})
                if not isinstance(snapshot, dict) or type(snapshot.get("version")) is not int or snapshot["version"] < 0:
                    raise OpenError("Invalid core document version")
                updated, result = plan_open(snapshot.get("value"), path, on, terminal, operation_id, new_tab)
                if not result["reused"]:
                    if acknowledged:
                        raise OpenError("Acknowledged operation is absent after retry; refusing recreation")
                    if uncertain_write:
                        raise OpenError("Unknown write outcome and operation absent; inspect state, refusing recreation")
                    try:
                        core.rpc("doc.set", {"name": DOC_NAME, "version": snapshot["version"], "value": updated})
                    except TransportError:
                        uncertain_write = True
                        raise
                    acknowledged = True
                    verified = core.rpc("doc.get", {"name": DOC_NAME})
                    if not isinstance(verified, dict) or type(verified.get("version")) is not int:
                        raise OpenError("Invalid layout readback")
                    _, found = plan_open(verified.get("value"), path, on, terminal, operation_id, new_tab)
                    if not found["reused"]:
                        raise OpenError("Accepted operation is absent on readback; refusing blind recreation")
                    result["version"] = verified["version"]
                else:
                    result["version"] = snapshot["version"]
                result.update({"file": path, "on": on, "client_pane": on + "/" + result["pane_id"], "focus": "client-local; unchanged"})
                return result
        except RpcError as error:
            if not error.conflict():
                raise
            last_error = error
        except TransportError as error:
            # Same ID on every local-socket retry: an accepted-but-lost response
            # is found on the next read rather than creating a duplicate pane.
            last_error = error
    detail = " Unknown write outcome; inspect state before any explicit retry." if uncertain_write else ""
    raise OpenError("Bounded local-core attempts exhausted: %s.%s Operation ID: %s" % (last_error, detail, operation_id))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", help="Markdown file on THIS machine (PDF unsupported)")
    parser.add_argument("--on", required=True, help="source machine alias as known to the connected desktop, e.g. devbox")
    parser.add_argument("--socket", default=os.environ.get("HC_TERMINAL_SOCKET"), help="local core UNIX socket (default HC_TERMINAL_SOCKET)")
    parser.add_argument("--terminal", default=os.environ.get("HC_TERMINAL_ID"), help="local source terminal ID (default HC_TERMINAL_ID)")
    parser.add_argument("--new-tab", action="store_true", help="add a tab in source workspace instead of splitting right")
    parser.add_argument("--operation-id", help="reuse printed 32-hex operation ID after an uncertain result")
    parser.add_argument("--retries", type=int, default=3, help="CAS/local-socket retries, 0..5 (default3)")
    parser.add_argument("--timeout", type=float, default=3, help="seconds per local-core request, .1..30 (default3)")
    args = parser.parse_args(argv)
    operation_id = args.operation_id or uuid.uuid4().hex
    try:
        if not re.fullmatch(r"[0-9a-f]{32}", operation_id):
            raise OpenError("Operation ID must be32 lowercase hex digits")
        if not ident(args.on) or args.on != args.on.strip():
            raise OpenError("--on must be an explicit non-empty desktop machine alias")
        if not ident(args.terminal) or "/" in args.terminal:
            raise OpenError("Need local HC_TERMINAL_ID or --terminal, without machine/ prefix")
        if not args.socket or not isinstance(args.socket, str) or not os.path.isabs(args.socket):
            raise OpenError("Need absolute local HC_TERMINAL_SOCKET or --socket; no network endpoint supported")
        if not 0 <= args.retries <= 5 or not math.isfinite(args.timeout) or not 0.1 <= args.timeout <= 30:
            raise OpenError("Invalid bounded retries/timeout")
        path = markdown_path(args.file)  # Validate before any core connection/write.
        result = open_document(args.socket, args.terminal, path, args.on, operation_id,
                               args.new_tab, args.retries, args.timeout)
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (OpenError, ValueError) as error:
        print("herdr-open: %s [operation-id %s]" % (error, operation_id), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
